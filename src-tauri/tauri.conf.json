{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Studio Desk",
  "version": "0.1.0",
  "identifier": "com.studiodesk.geminiplayground",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Google AI Studio",
        "width": 1366,
        "height": 768,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "backgroundColor": [
          23,
          23,
          23,
          255
        ]
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://generativelanguage.googleapis.com https://ai.google.dev; img-src 'self' data: asset:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A lightweight Gemini Playground desktop client",
    "longDescription": "A low-overhead Windows desktop Playground client for free-tier eligible Gemini text models.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
